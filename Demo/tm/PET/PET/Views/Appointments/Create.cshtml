@model PET.Models.Appointment

@{
    ViewData["Title"] = "Đặt lịch hẹn Spa";
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Nút quay lại -->
                <div class="mb-3">
                    <a asp-action="Index" class="text-decoration-none fw-bold text-muted">
                        ← Quay lại danh sách lịch hẹn
                    </a>
                </div>

                <!-- Card Form -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom p-4">
                        <span class="kicker is-coral mb-2">
                            <svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
                            Đặt lịch trực tuyến
                        </span>
                        <h1 class="h3 fw-bold mb-1">Đặt lịch chăm sóc cho bé cưng</h1>
                        <p class="text-muted small mb-0">Chọn bé cưng, gói dịch vụ và khung giờ thuận tiện nhất cho bạn.</p>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                            <div class="row g-3">
                                <!-- Chọn thú cưng -->
                                <div class="col-md-6">
                                    <label asp-for="PetId" class="form-label fw-bold">Chọn thú cưng <span class="text-danger">*</span></label>
                                    <select asp-for="PetId" class="form-select rounded-3" asp-items="ViewBag.PetId">
                                        <option value="">-- Chọn bé cưng của bạn --</option>
                                    </select>
                                    <span asp-validation-for="PetId" class="text-danger small"></span>
                                </div>

                                <!-- Chọn dịch vụ -->
                                <div class="col-md-6">
                                    <label asp-for="ServiceId" class="form-label fw-bold">Chọn dịch vụ Spa <span class="text-danger">*</span></label>
                                    <select asp-for="ServiceId" class="form-select rounded-3" asp-items="ViewBag.ServiceId">
                                        <option value="">-- Chọn gói dịch vụ --</option>
                                    </select>
                                    <span asp-validation-for="ServiceId" class="text-danger small"></span>
                                </div>

                                <!-- Chọn ngày giờ hẹn -->
                                <div class="col-12">
                                    <label asp-for="AppointmentDate" class="form-label fw-bold">Ngày và giờ hẹn <span class="text-danger">*</span></label>
                                    <input asp-for="AppointmentDate" type="datetime-local" class="form-control rounded-3" />
                                    <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                                    <div class="form-text">Giờ mở cửa Fetch Salon: 08:00 – 20:00 tất cả các ngày trong tuần.</div>
                                </div>

                                <!-- Ghi chú -->
                                <div class="col-12">
                                    <label asp-for="Notes" class="form-label fw-bold">Ghi chú thêm cho nhân viên</label>
                                    <textarea asp-for="Notes" rows="3" class="form-control rounded-3" placeholder="VD: Bé hơi nhát người lạ, lưu ý nhẹ tay vùng tai, hoặc yêu cầu kiểu cắt tỉa..."></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Nút hành động -->
                            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-ghost">Hủy bỏ</a>
                                <button type="submit" class="btn btn-paw btn-icon px-4">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                                    Xác nhận đặt lịch
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}