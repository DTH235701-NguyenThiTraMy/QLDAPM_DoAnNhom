    <script src="~/Interface/js/jquery.magnific-popup.min.js"></script>
    <script src="~/Interface/js/scrollax.min.js"></script>
    <script src="~/Interface/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

