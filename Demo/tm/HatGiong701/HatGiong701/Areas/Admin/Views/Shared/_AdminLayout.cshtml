@using Microsoft.AspNetCore.Identity
@using HatGiong701.Models
@inject UserManager<User> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrEmpty(currentUser?.FullName) ? currentUser.FullName : "Quản trị viên";
    var avatarUrl = currentUser?.AvatarUrl;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hạt Giống</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- MENU DỌC BÊN TRÁI (SIDEBAR) -->
            <nav class="col-md-3 col-lg-2 d-flex flex-column sidebar py-4 px-0">
                <!-- Phần đầu thương hiệu -->
                <div class="text-center mb-3 px-3">
                    <h4 class="fw-bold text-white mb-0">🌱 HạtGiống701</h4>
                    <small class="text-warning">Hệ thống Quản trị</small>
                </div>

                <hr class="border-success mx-3" />

                <!-- Danh sách chức năng chính -->
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link-custom @(currentController == "Dashboard" ? "active" : "")"
                           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-bar-chart-line-fill me-2"></i> Bảng thống kê
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(currentController == "Categories" ? "active" : "")"
                           asp-area="Admin" asp-controller="Categories" asp-action="Index">
                            <i class="bi bi-folder-fill me-2"></i> Quản lý Danh mục
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(currentController == "Seeds" ? "active" : "")"
                           asp-area="Admin" asp-controller="Seeds" asp-action="Index">
                            <i class="bi bi-flower1 me-2"></i> Quản lý Hạt giống
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(currentController == "Orders" ? "active" : "")"
                           asp-area="Admin" asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-box-seam-fill me-2"></i> Quản lý Đơn hàng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(currentController == "AdminBlog" ? "active" : "")"
                           asp-area="Admin" asp-controller="AdminBlog" asp-action="Index">
                            <i class="bi bi-journal-richtext me-2"></i> Quản lý Cẩm nang
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(currentController == "Users" ? "active" : "")"
                           asp-area="Admin" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people-fill me-2"></i> Quản lý Tài khoản
                        </a>
                    </li>
                </ul>

                <hr class="border-success mx-3 my-3" />

                <!-- Lối tắt nhanh -->
                <div class="px-3 mb-3">
                    <small class="text-uppercase text-white-50 fw-bold d-block mb-2 px-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                        Lối tắt nhanh
                    </small>
                    <a asp-area="Admin" asp-controller="Seeds" asp-action="Create" class="btn btn-outline-light btn-sm w-100 text-start mb-2">
                        <i class="bi bi-plus-circle me-2"></i> Thêm hạt giống mới
                    </a>
                    <a asp-area="Admin" asp-controller="AdminBlog" asp-action="Create" class="btn btn-outline-light btn-sm w-100 text-start mb-2">
                        <i class="bi bi-pencil-square me-2"></i> Viết bài cẩm nang mới
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-warning btn-sm w-100 fw-bold text-dark">
                        <i class="bi bi-shop me-1"></i> Về trang Cửa hàng
                    </a>
                </div>

                <!-- Thông tin tài khoản Admin ở chân Sidebar -->
                <div class="mt-auto px-3 pt-3">
                    <div class="sidebar-footer-card p-3 text-light small">
                        <div class="d-flex align-items-center mb-2">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Avatar" class="rounded-circle border border-warning me-2"
                                     style="width: 38px; height: 38px; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-badge-fill text-warning fs-4 me-2"></i>
                            }
                            <div class="overflow-hidden">
                                <div class="fw-bold text-truncate">@displayName</div>
                                <span class="badge bg-success text-white" style="font-size: 0.7rem;">● Đang hoạt động</span>
                            </div>
                        </div>
                        <div class="text-white-50 border-top border-success pt-2 mt-2" style="font-size: 0.78rem;">
                            <div><i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")</div>
                            <div><i class="bi bi-shield-check me-1"></i> Quyền: Admin</div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- KHUNG NỘI DUNG BÊN PHẢI -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <!-- Thanh Topbar -->
                <div class="d-flex justify-content-between align-items-center py-3 px-4 my-3 rounded-3 topbar">
                    <span class="fw-bold text-success fs-5">@ViewData["Title"]</span>
                    <div class="d-flex align-items-center gap-3">
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="text-dark fw-semibold text-decoration-none d-flex align-items-center gap-2" title="Hồ sơ cá nhân">
                            @if (!string.IsNullOrEmpty(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="Avatar" class="rounded-circle border border-success"
                                     style="width: 30px; height: 30px; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle text-success fs-5"></i>
                            }
                            <span>Xin chào, @displayName</span>
                        </a>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                              onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất khỏi tài khoản không?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Vùng hiển thị nội dung các trang con -->
                <div class="bg-white p-4 rounded-3 shadow-sm mb-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>