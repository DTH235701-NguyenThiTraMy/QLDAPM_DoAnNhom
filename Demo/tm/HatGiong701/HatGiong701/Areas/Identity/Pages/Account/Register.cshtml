@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border shadow-sm rounded-3 p-4">
            <div class="text-center mb-4">
                <h4 class="fw-bold text-success mb-1">Đăng ký tài khoản</h4>
                <small class="text-muted">Tạo tài khoản thành viên Cửa hàng Hạt giống</small>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label fw-semibold">Tên tài khoản</label>
                    <input asp-for="Input.FullName" class="form-control" placeholder="Nhập tên tài khoản của bạn" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Địa chỉ Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold">Mật khẩu</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn btn-success fw-semibold py-2 mb-3">
                    Đăng ký
                </button>

                <div class="text-center small">
                    <span class="text-muted">Đã có tài khoản?</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-success fw-bold text-decoration-none">
                        Đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}