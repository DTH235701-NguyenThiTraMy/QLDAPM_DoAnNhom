@{
    ViewData["Title"] = "Phân công nhân viên";
    var appointment = ViewBag.Appointment as PMPetCare.Models.Appointment;
}

<div class="container py-4">
    <h2 class="mb-4">Phân công nhân viên</h2>

    @if (appointment != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5>Thông tin lịch hẹn #@appointment.AppointmentId</h5>
                <p class="mb-1">
                    <strong>Thú cưng:</strong> @appointment.Pet?.PetName
                </p>
                <p class="mb-1">
                    <strong>Dịch vụ:</strong> @appointment.Service?.ServiceName
                </p>
                <p class="mb-0">
                    <strong>Thời gian:</strong>
                    @appointment.AppointmentDate.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="AssignStaff" method="post">
                <input type="hidden" name="id"
                       value="@appointment?.AppointmentId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Chọn nhân viên</label>
                    <select name="staffId"
                            class="form-select"
                            asp-items="ViewBag.StaffId"
                            required>
                        <option value="">-- Chọn nhân viên --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Xác nhận phân công
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>
