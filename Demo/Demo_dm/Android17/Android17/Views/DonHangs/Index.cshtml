@model List<Android17.Models.DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var vn = new System.Globalization.CultureInfo("vi-VN");
    int? loc = ViewBag.trangThai as int?;
    string[] ten = { "Chờ xác nhận", "Đã xác nhận", "Đang giao", "Hoàn thành", "Đã hủy" };
}

<h4 class="mb-3">Quản lý đơn hàng</h4>

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(loc == null ? "active" : "")" asp-action="Index">Tất cả</a>
    </li>
    @for (int i = 0; i < ten.Length; i++)
    {
        <li class="nav-item">
            <a class="nav-link @(loc == i ? "active" : "")" asp-action="Index" asp-route-trangThai="@i">@ten[i]</a>
        </li>
    }
</ul>

@if (Model.Count == 0)
{
    <p class="text-muted">Không có đơn hàng nào.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Người nhận</th>
                    <th>Thanh toán</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>#@d.Dhid</td>
                        <td>@d.NgayTaoDon.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@d.NguoiNhan<br /><small class="text-muted">@d.SdtnguoiNhan</small></td>
                        <td>@d.PthucThanhToan</td>
                        <td class="text-end">@d.ThanhTien.ToString("N0", vn) ₫</td>
                        <td><partial name="_TrangThaiDon" model="d.TrangThai" /></td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@d.Dhid">Xem / xử lý</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}