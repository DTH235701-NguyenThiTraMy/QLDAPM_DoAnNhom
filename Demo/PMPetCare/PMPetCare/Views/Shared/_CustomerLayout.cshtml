
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PMPetCare</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:200,300,400,500,600,700,800&display=swap"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" />

    <!-- Petsitting CSS -->
    <link rel="stylesheet" href="~/Interface/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Interface/css/animate.css" />
    <link rel="stylesheet" href="~/Interface/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/Interface/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="~/Interface/css/magnific-popup.css" />
    <link rel="stylesheet" href="~/Interface/css/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="~/Interface/css/jquery.timepicker.css" />
    <link rel="stylesheet" href="~/Interface/css/flaticon.css" />
    <link rel="stylesheet" href="~/Interface/css/style.css" />

</head>
<body>

    @RenderBody()

    <!-- Petsitting JavaScript -->
    <script src="~/Interface/js/jquery.min.js"></script>
    <script src="~/Interface/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="~/Interface/js/popper.min.js"></script>
    <script src="~/Interface/js/bootstrap.min.js"></script>
    <script src="~/Interface/js/jquery.easing.1.3.js"></script>
    <script src="~/Interface/js/jquery.waypoints.min.js"></script>
