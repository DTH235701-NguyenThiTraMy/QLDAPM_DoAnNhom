@model PET.Models.Pet

@{
    ViewData["Title"] = "Hồ sơ " + Model.Name;
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <!-- Điều hướng quay lại -->
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none fw-bold text-muted">
                ← Quay lại danh sách thú cưng
            </a>
        </div>

        <div class="row g-4">
            <!-- Cột trái: Thông tin chi tiết hồ sơ -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <div class="row g-0 h-100">
                        <!-- Ảnh đại diện thú cưng -->
                        <div class="col-md-5 bg-light position-relative" style="min-height: 280px;">
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/img/pet-1.jpg") : Model.ImageUrl)"
                                 alt="@Model.Name"
                                 class="w-100 h-100"
                                 style="object-fit: cover;" />
                            <span class="badge bg-primary position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                @Model.Species
                            </span>
                        </div>

                        <!-- Nội dung thông tin -->
                        <div class="col-md-7 d-flex flex-column justify-content-between p-4 p-md-5 bg-white">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h1 class="h2 fw-bold mb-0">@Model.Name</h1>
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">@Model.Weight kg</span>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-6">
                                        <div class="text-muted small">Giống</div>
                                        <div class="fw-bold">@(string.IsNullOrEmpty(Model.Breed) ? "Chưa cập nhật" : Model.Breed)</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small">Ngày sinh</div>
                                        <div class="fw-bold">@(Model.BirthDate.HasValue? Model.BirthDate.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</div>
                                    </div>
                                    @if (User.IsInRole("Admin") && Model.User != null)
                                    {
                                        <div class="col-12">
                                            <div class="text-muted small">Chủ nuôi</div>
                                            <div class="fw-bold text-primary">@Model.User.Email</div>
                                        </div>
                                    }
                                </div>

                                <div class="p-3 rounded-3 bg-light border-start border-4 border-primary mb-4">
                                    <div class="small fw-bold text-dark mb-1">Tiền sử bệnh lý / Lưu ý chăm sóc:</div>
                                    <div class="text-muted small mb-0">
                                        @(string.IsNullOrEmpty(Model.MedicalHistory) ? "Sức khỏe ổn định, không có lưu ý đặc biệt." : Model.MedicalHistory)
                                    </div>
                                </div>
                            </div>

                            <!-- Các nút thao tác -->
                            <div class="d-flex flex-wrap gap-2 pt-3 border-top">
                                <a asp-controller="Appointments" asp-action="Create" class="btn btn-paw btn-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                                    Đặt lịch Spa cho @Model.Name
                                </a>
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ghost">Chỉnh sửa</a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-3">Xóa</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thẻ Mã QR định danh -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100 d-flex flex-column justify-content-center align-items-center">
                    <span class="kicker is-coral mb-2">Thẻ định danh điện tử</span>
                    <h3 class="h5 fw-bold mb-2">Mã QR của @Model.Name</h3>
                    <p class="text-muted small mb-4">Quét mã để tra cứu nhanh hồ sơ sức khỏe và thông tin liên hệ của bé.</p>

                    @if (!string.IsNullOrEmpty(Model.QRCodePath))
                    {
                        <div class="p-3 bg-light rounded-4 border mb-4 shadow-sm">
                            <img src="@Model.QRCodePath" alt="Mã QR của @Model.Name" style="width: 200px; height: 200px;" />
                        </div>

                        <a href="@Model.QRCodePath" download="QR_@(Model.Name).png" class="btn btn-outline-primary rounded-pill px-4">
                            ⬇ Tải ảnh QR về máy
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning small w-100">
                            Chưa có mã QR cho hồ sơ này. Hãy bấm <strong>Chỉnh sửa</strong> rồi lưu lại để tạo mã.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>