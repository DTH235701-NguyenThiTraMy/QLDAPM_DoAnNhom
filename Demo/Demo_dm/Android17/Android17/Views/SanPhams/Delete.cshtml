@model Android17.Models.SanPham
@{
    ViewData["Title"] = "Xóa sản phẩm";
    var vn = new System.Globalization.CultureInfo("vi-VN");
}

<h4>Xóa sản phẩm</h4>
<hr />
<div class="row">
    <div class="col-md-3">
        <img src="~/images/@Model.Anh" alt="" class="img-fluid" onerror="this.style.display='none'" />
    </div>
    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Tên sản phẩm</dt>
            <dd class="col-sm-9">@Model.TenSp</dd>
            <dt class="col-sm-3">Loại / Hãng</dt>
            <dd class="col-sm-9">@Model.Loai.TenLoai / @Model.NhanHang.TenNhanHang</dd>
            <dt class="col-sm-3">Giá bán</dt>
            <dd class="col-sm-9">@Model.Gia.ToString("N0", vn) ₫</dd>
            <dt class="col-sm-3">Tồn kho</dt>
            <dd class="col-sm-9">@Model.TonKho</dd>
        </dl>
    </div>
</div>

<div class="alert alert-info">
    Sản phẩm chưa có trong đơn hàng nào sẽ bị <strong>xóa hẳn</strong> (và gỡ khỏi giỏ hàng của khách).
    Sản phẩm đã có trong đơn hàng thì không thể xóa, hệ thống sẽ chuyển sang trạng thái <strong>Đã ẩn</strong>.
</div>

<h5 class="text-danger">Bạn có chắc muốn tiếp tục?</h5>
<form asp-action="Delete" asp-route-id="@Model.Spid" method="post">
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>