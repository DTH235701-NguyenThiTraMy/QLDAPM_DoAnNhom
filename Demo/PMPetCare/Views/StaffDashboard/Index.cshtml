@model IEnumerable<PMPetCare.Models.Appointment>

@{
    ViewData["Title"] = "Tổng quan nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2>Xin chào, @ViewBag.StaffName!</h2>
        <p class="text-muted">Tổng quan công việc chăm sóc thú cưng của bạn.</p>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Tổng lịch được giao</p>
                <h3>@ViewBag.TotalAppointments</h3>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Lịch hôm nay</p>
                <h3>@ViewBag.TodayAppointments</h3>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Đang thực hiện</p>
                <h3>@ViewBag.InProgressCount</h3>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Đã hoàn thành</p>
                <h3>@ViewBag.CompletedCount</h3>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-white">
            <h5 class="mb-0">Lịch làm việc hôm nay</h5>
        </div>

        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Khách hàng</th>
                                <th>Thú cưng</th>
                                <th>Dịch vụ</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var statusText = item.Status switch
                                {
                                    "Assigned" => "Đã phân công",
                                    "InProgress" => "Đang thực hiện",
                                    "Completed" => "Đã hoàn thành",
                                    "Cancelled" => "Đã hủy",
                                    _ => item.Status
                                };

                                <tr>
                                    <td>@item.AppointmentDate.ToString("HH:mm")</td>
                                    <td>@item.Customer?.FullName</td>
                                    <td>@item.Pet?.PetName</td>
                                    <td>@item.Service?.ServiceName</td>
                                    <td>@statusText</td>
                                    <td>
                                        <a asp-controller="StaffAppointments"
                                           asp-action="Details"
                                           asp-route-id="@item.AppointmentId"
                                           class="btn btn-primary btn-sm">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Bạn không có lịch làm việc hôm nay.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="StaffAppointments"
           asp-action="Index"
           class="btn btn-outline-primary">
            Xem tất cả lịch được phân công
        </a>
    </div>
</div>
