@model IEnumerable<PET.Models.Product>

@{
    ViewData["Title"] = "Cửa hàng sản phẩm thú cưng";
    var displayProducts = User.IsInRole("Admin")
        ? Model
        : Model.Where(p => p.IsActive);

    var categories = displayProducts
        .Select(p => string.IsNullOrEmpty(p.Category) ? "Sản phẩm" : p.Category)
        .Distinct()
        .ToList();
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <!-- Tiêu đề & Nút thêm mới (chỉ hiện với Admin) -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
            <div class="section-head mb-0">
                <span class="kicker is-yellow">
                    <svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
                    Cửa hàng Fetch
                </span>
                <h1 class="section-title mb-2">Phụ kiện & Dinh dưỡng thú cưng</h1>
                <p class="section-sub mb-0">Các dòng sữa tắm thảo mộc, bánh thưởng và phụ kiện chăm sóc chuẩn Salon dành cho bé.</p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div>
                    <a asp-action="Create" class="btn btn-paw btn-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                        Thêm sản phẩm mới
                    </a>
                </div>
            }
        </div>

        @if (displayProducts.Any())
        {
            <!-- Thanh tìm kiếm & Lọc danh mục nhanh -->
            <div class="bg-white p-3 rounded-4 shadow-sm border mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex flex-wrap gap-2" id="categoryFilterGroup">
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 filter-cat-btn active" data-category="all">Tất cả (@displayProducts.Count())</button>
                    @foreach (var cat in categories)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-cat-btn" data-category="@cat">@cat</button>
                    }
                </div>
                <div style="min-width: 240px;">
                    <input type="text" id="productSearchInput" class="form-control form-control-sm rounded-pill px-3" placeholder="🔍 Tìm tên sản phẩm..." />
                </div>
            </div>
        }

        @if (!displayProducts.Any())
        {
            <div class="text-center p-5 bg-white rounded-4 shadow-sm border">
                <div style="font-size: 48px;" class="mb-3">🛍️</div>
                <h3>Chưa có sản phẩm nào được bày bán</h3>
                <p class="text-muted mb-4">Cửa hàng đang cập nhật thêm các mặt hàng mới, vui lòng quay lại sau nhé!</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-paw">Thêm sản phẩm đầu tiên</a>
                }
            </div>
        }
        else
        {
            <!-- Danh sách thẻ sản phẩm chuẩn style Fetch -->
            <div class="row g-4" id="productGrid">
                @foreach (var item in displayProducts)
                {
                    var catName = string.IsNullOrEmpty(item.Category) ? "Sản phẩm" : item.Category;

                    <div class="col-6 col-md-4 col-lg-3 product-col" data-category="@catName" data-name="@item.Name.ToLower()">
                        <div class="shop-card h-100 d-flex flex-column justify-content-between">
                            <div>
                                <!-- Hình ảnh (bấm vào để xem chi tiết) & Nhãn trạng thái -->
                                <div class="shop-thumb position-relative">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="d-block">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/img/product-1.jpg") : item.ImageUrl)"
                                             alt="@item.Name"
                                             width="300" height="300" loading="lazy" />
                                    </a>

                                    @if (!item.IsActive)
                                    {
                                        <span class="shop-flag bg-secondary text-white">Ngừng bán</span>
                                    }
                                    else if (item.StockQuantity <= 0)
                                    {
                                        <span class="shop-flag bg-danger text-white">Hết hàng</span>
                                    }
                                    else if (item.StockQuantity <= 5)
                                    {
                                        <span class="shop-flag">Sắp hết (@item.StockQuantity)</span>
                                    }
                                </div>

                                <!-- Thông tin sản phẩm -->
                                <div class="shop-body pb-2">
                                    <span class="cat">@catName</span>
                                    <h3 class="mb-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                            @item.Name
                                        </a>
                                    </h3>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @item.Description
                                        </p>
                                    }
                                </div>
                            </div>

                            <!-- Giá & Nút Thêm vào giỏ nằm gọn gàng ở đáy thẻ -->
                            <div class="px-3 pb-3 pt-2">
                                <div class="shop-foot align-items-center">
                                    <div>
                                        <span class="shop-price">@item.Price.ToString("N0")đ</span>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div class="small text-muted">Kho: <strong>@item.StockQuantity</strong></div>
                                        }
                                    </div>

                                    @if (item.IsActive && item.StockQuantity > 0)
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-paw btn-sm px-3 text-nowrap" title="Thêm vào giỏ hàng">
                                                🛒 Thêm
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-2 py-1">Hết hàng</span>
                                    }
                                </div>

                                <!-- Thanh quản trị dành riêng cho Admin -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="mt-3 pt-2 border-top d-flex justify-content-between gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill flex-fill">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill flex-fill">Xóa</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterBtns = document.querySelectorAll(".filter-cat-btn");
            const searchInput = document.getElementById("productSearchInput");
            const cards = document.querySelectorAll(".product-col");
            let currentCategory = "all";

            function applyFilters() {
                const keyword = (searchInput?.value || "").trim().toLowerCase();
                cards.forEach(card => {
                    const cardCat = card.getAttribute("data-category");
                    const cardName = card.getAttribute("data-name") || "";
                    const matchCat = currentCategory === "all" || cardCat === currentCategory;
                    const matchName = !keyword || cardName.includes(keyword);
                    card.style.display = (matchCat && matchName) ? "" : "none";
                });
            }

            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => {
                        b.classList.remove("btn-dark", "active");
                        b.classList.add("btn-outline-secondary");
                    });
                    this.classList.remove("btn-outline-secondary");
                    this.classList.add("btn-dark", "active");
                    currentCategory = this.getAttribute("data-category");
                    applyFilters();
                });
            });

            if (searchInput) {
                searchInput.addEventListener("input", applyFilters);
            }
        });
    </script>
}