@page
@model PMPetCare.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PMPetCare - Đăng ký</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: #ff8018;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 20px;
        }

        .register-card {
            width: 100%;
            max-width: 1080px;
            min-height: 650px;
            background: white;
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            box-shadow: 0 12px 35px rgba(100, 45, 0, .2);
        }

        .register-form {
            width: 50%;
            padding: 45px 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .brand {
            color: #f47b20;
            font-size: 27px;
            font-weight: bold;
            margin-bottom: 32px;
        }

        .register-form h2 {
            font-size: 27px;
            font-weight: 700;
            color: #222;
            margin-bottom: 10px;
        }

        .description {
            color: #888;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #444;
            margin-bottom: 7px;
        }

        .form-control {
            height: 43px;
            border-radius: 5px;
            font-size: 14px;
        }

        .input-group .form-control {
            height: 43px;
        }

        .password-toggle {
            background: white;
            border: 1px solid #ced4da;
            color: #777;
        }

            .password-toggle:hover {
                background: #fff3e8;
                color: #f47b20;
            }

        .register-btn {
            width: 100%;
            height: 46px;
            border: none;
            border-radius: 25px;
            background: #ff851b;
            color: white;
            font-weight: bold;
            margin-top: 10px;
            transition: .2s;
        }

            .register-btn:hover {
                background: #e96d08;
            }

        .login-link {
            text-align: center;
            font-size: 13px;
            color: #888;
            margin-top: 18px;
        }

            .login-link a {
                color: #333;
                font-weight: bold;
            }

        .register-image {
            width: 50%;
            background: #258eb7;
            position: relative;
            overflow: hidden;
        }

            .register-image img {
                width: 100%;
                height: 100%;
                min-height: 650px;
                object-fit: cover;
            }

        .validation {
            font-size: 12px;
        }

        @@media (max-width: 768px) {
            body {
                padding: 20px 12px;
            }

            .register-card {
                max-width: 480px;
                min-height: auto;
            }

            .register-form {
                width: 100%;
                padding: 35px 25px;
            }

            .register-image {
                display: none;
            }
        }
    </style>
</head>

<body>
    <div class="register-card">

        <div class="register-form">

            <div class="brand">
                <i class="bi bi-heart-fill"></i> PMPetCare
            </div>

            <h2>Tạo tài khoản mới</h2>

            <p class="description">
                Tham gia PMPetCare để chăm sóc thú cưng của bạn tốt hơn mỗi ngày.
            </p>

            <form method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label"></label>
                    <input asp-for="Input.FullName"
                           class="form-control"
                           placeholder="Nhập họ và tên" />
                    <span asp-validation-for="Input.FullName"
                          class="text-danger validation"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="example@gmail.com" />
                    <span asp-validation-for="Input.Email"
                          class="text-danger validation"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>

                    <div class="input-group">
                        <input asp-for="Input.Password"
                               class="form-control"
                               id="password"
                               placeholder="Nhập mật khẩu" />

                        <button type="button"
                                class="btn password-toggle"
                                onclick="togglePassword('password', 'eyePassword')">
                            <i class="bi bi-eye" id="eyePassword"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger validation"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword"
                           class="form-label"></label>

                    <div class="input-group">
                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               id="confirmPassword"
                               placeholder="Nhập lại mật khẩu" />

                        <button type="button"
                                class="btn password-toggle"
                                onclick="togglePassword('confirmPassword', 'eyeConfirmPassword')">
                            <i class="bi bi-eye" id="eyeConfirmPassword"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger validation"></span>
                </div>

                <button type="submit" class="register-btn">
                    ĐĂNG KÝ
                </button>
            </form>

            <div class="login-link">
                Đã có tài khoản?
                <a asp-page="/Account/Login"
                   asp-area="Identity">Đăng nhập</a>
            </div>

        </div>

        <div class="register-image">
            <img src="~/Interface/images/about-1.jpg"
                 alt="Chăm sóc thú cưng PMPetCare" />
        </div>

    </div>

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>
</body>a
</html>
