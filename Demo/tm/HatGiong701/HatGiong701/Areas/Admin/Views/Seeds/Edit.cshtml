@model HatGiong701.Models.Seed

@{
    ViewData["Title"] = $"Chỉnh sửa: {Model.Name}";
}

<div class="container-fluid py-3">
    <!-- Header & Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb" class="mb-1">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" class="text-success text-decoration-none">Quản lý hạt giống</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">
                Chỉnh sửa sản phẩm hạt giống
            </h3>
            <p class="text-muted small mb-0">Cập nhật thông tin bán hàng, tồn kho và đặc tính sinh trưởng</p>
        </div>

        <a asp-action="Index" class="btn btn-light bg-white border text-dark rounded-3 px-3 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert"></div>
        <input type="hidden" asp-for="SeedId" />

        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN CƠ BẢN & HÌNH ẢNH -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-card-text text-success me-2"></i>Thông tin cơ bản
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="Name" class="form-control rounded-3" placeholder="VD: Hạt giống Cải ngọt ăn non..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold text-dark">Danh mục hạt giống</label>
                            <select asp-for="CategoryId" class="form-select rounded-3" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <input asp-for="Price" class="form-control" type="number" min="0" step="500" />
                                    <span class="input-group-text bg-light">₫</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                                    <span class="input-group-text bg-light">gói</span>
                                </div>
                                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Hình ảnh hiện tại & Upload ảnh mới kèm xem trước -->
                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-semibold text-dark">Hình ảnh hạt giống</label>
                            <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border">
                                <img id="imagePreview"
                                     src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/seeds/seed1.jpg" : Model.ImageUrl)"
                                     alt="@Model.Name"
                                     style="width: 76px; height: 76px; object-fit: cover;"
                                     class="rounded-3 border bg-white shadow-sm flex-shrink-0" />
                                <div class="flex-grow-1">
                                    <input asp-for="ImageUrl" id="imageUrlInput" class="form-control form-control-sm mb-2" placeholder="/images/seeds/..." />
                                    <input type="file" name="imageFile" id="imageFileInput" class="form-control form-control-sm" accept="image/*" />
                                    <small class="text-muted d-block mt-1">Chọn tệp mới để thay ảnh hoặc giữ nguyên đường dẫn hiện tại</small>
                                </div>
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Description" class="form-label fw-semibold text-dark"></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: THÔNG SỐ GIEO TRỒNG -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-sliders text-success me-2"></i>Đặc tính & Hướng dẫn gieo trồng
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="PlantingSeason" class="form-label fw-semibold text-dark"></label>
                                <select asp-for="PlantingSeason" class="form-select rounded-3">
                                    <option value="Quanh năm">Quanh năm</option>
                                    <option value="Xuân">Xuân</option>
                                    <option value="Hè">Hè</option>
                                    <option value="Thu">Thu</option>
                                    <option value="Đông">Đông</option>
                                </select>
                                <span asp-validation-for="PlantingSeason" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SuitableSpace" class="form-label fw-semibold text-dark"></label>
                                <select asp-for="SuitableSpace" class="form-select rounded-3">
                                    <option value="Ban công">Ban công</option>
                                    <option value="Sân vườn">Sân vườn</option>
                                    <option value="Thủy canh">Thủy canh</option>
                                    <option value="Trong nhà">Trong nhà</option>
                                </select>
                                <span asp-validation-for="SuitableSpace" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CareLevel" class="form-label fw-semibold text-dark"></label>
                                <select asp-for="CareLevel" class="form-select rounded-3">
                                    <option value="Dễ">Dễ</option>
                                    <option value="Trung bình">Trung bình</option>
                                    <option value="Khó">Khó</option>
                                </select>
                                <span asp-validation-for="CareLevel" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="GerminationRate" class="form-label fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <input asp-for="GerminationRate" class="form-control" type="number" min="0" max="100" />
                                    <span class="input-group-text bg-light">%</span>
                                </div>
                                <span asp-validation-for="GerminationRate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="HarvestDays" class="form-label fw-semibold text-dark"></label>
                                <div class="input-group">
                                    <input asp-for="HarvestDays" class="form-control" type="number" min="1" />
                                    <span class="input-group-text bg-light">ngày</span>
                                </div>
                                <span asp-validation-for="HarvestDays" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="PlantingGuide" class="form-label fw-semibold text-dark"></label>
                            <textarea asp-for="PlantingGuide" class="form-control rounded-3" rows="7"></textarea>
                            <span asp-validation-for="PlantingGuide" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- THANH NÚT THAO TÁC -->
        <div class="card border-0 shadow-sm rounded-4 mt-4">
            <div class="card-body py-3 px-4 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light border rounded-3 px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold">
                    <i class="bi bi-check2-circle me-1"></i>Cập nhật hạt giống
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/admin-seeds.js" asp-append-version="true"></script>
}