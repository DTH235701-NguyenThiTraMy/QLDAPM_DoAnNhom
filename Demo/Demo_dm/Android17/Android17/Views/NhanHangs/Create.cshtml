@model Android17.Models.NhanHang
@{
    ViewData["Title"] = "Thêm nhãn hàng";
}

<h4>Thêm nhãn hàng</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="mb-3">
                <label asp-for="TenNhanHang" class="form-label">Tên nhãn hàng</label>
                <input asp-for="TenNhanHang" class="form-control" maxlength="100" />
                <span asp-validation-for="TenNhanHang" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </form>
    </div>
</div>