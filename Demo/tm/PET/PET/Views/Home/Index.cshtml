@{
    ViewData["Title"] = "Trang chủ";
}

<!-- ============================================================= HERO -->
<section class="hero" id="home">
    <div class="paw-scatter" aria-hidden="true">
        <svg class="paw" style="top:14%;left:6%;width:46px" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
        <svg class="paw" style="bottom:12%;left:40%;width:34px" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
    </div>
    <div class="container container-x position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 reveal">
                <span class="hero-tag"><span class="dot"></span> Đồng hành cùng thú cưng từ 2014</span>
                <h1>Thú cưng vui khỏe, <span class="swoosh">sạch sẽ & mượt mà</span> mỗi ngày.</h1>
                <p class="hero-lead">Fetch là trung tâm chăm sóc thú cưng tận tâm, nơi các bé cún thư giãn, các bé mèo thoải mái và mỗi bộ lông đều được chăm chút mềm mượt.</p>
                <div class="hero-cta">
                    <a class="btn btn-paw btn-lg btn-icon" asp-controller="Appointments" asp-action="Create">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                        Đặt lịch Spa ngay
                    </a>
                    <a class="btn btn-ghost btn-lg" asp-controller="Services" asp-action="Index">Xem dịch vụ</a>
                </div>
                <div class="hero-stats">
                    <div class="hero-stat">
                        <div class="num"><span data-count="12000" data-suffix="+">0</span></div>
                        <div class="lbl">Lượt chăm sóc</div>
                    </div>
                    <div class="hero-stat">
                        <div class="num"><span data-count="4.9">0</span>★</div>
                        <div class="lbl">Đánh giá từ 800+ chủ nuôi</div>
                    </div>
                    <div class="hero-stat">
                        <div class="num"><span data-count="9">0</span></div>
                        <div class="lbl">Chuyên viên chứng chỉ</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 reveal d2">
                <div class="hero-media">
                    <svg class="hero-blob" viewBox="0 0 200 200" fill="currentColor" aria-hidden="true"><path d="M42.7,-63.8C55.9,-56.5,67.2,-45,72.8,-31.1C78.4,-17.2,78.3,-0.9,74.3,14.2C70.3,29.2,62.4,43,50.9,53.4C39.4,63.9,24.3,71,7.9,73.5C-8.6,76.1,-26.3,74.1,-40.6,66.1C-54.9,58.1,-65.7,44.2,-71.7,28.7C-77.6,13.1,-78.6,-4.1,-73.9,-19.3C-69.2,-34.6,-58.8,-47.9,-45.7,-55.3C-32.6,-62.7,-16.3,-64.2,-0.3,-63.8C15.8,-63.4,31.5,-71.1,42.7,-63.8Z" transform="translate(100 100)" /></svg>
                    <img class="hero-photo" src="~/img/hero-grooming.jpg" alt="Chú chó Golden Retriever đang được tắm gội nhẹ nhàng" width="640" height="704" fetchpriority="high">
                    <div class="hero-badge b1">
                        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg></span>
                        <div><span>Không căng thẳng</span><small>nâng niu nhẹ nhàng</small></div>
                    </div>
                    <div class="hero-badge b2">
                        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8a7 7 0 0 1-7 10z" /><path d="M8 20a4 4 0 0 0-1-8" /></svg></span>
                        <div><span>Tự nhiên</span><small>sản phẩm thảo mộc</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="wave" aria-hidden="true">
        <svg viewBox="0 0 1440 70" preserveAspectRatio="none"><path fill="#ffffff" d="M0,40 C240,72 480,72 720,48 C960,24 1200,8 1440,36 L1440,70 L0,70 Z" /></svg>
    </div>
</section>

<!-- ============================================================= TRUST STRIP -->
<div class="trust-strip">
    <div class="container container-x">
        <div class="row row-cols-2 row-cols-md-4 g-3 text-center text-md-start justify-content-between">
            <div class="col"><span class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 6v6c0 5 3.8 8.4 9 10 5.2-1.6 9-5 9-10V6z" /><path d="m9 12 2 2 4-4" /></svg> Chứng nhận Fear-Free</span></div>
            <div class="col"><span class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z" /></svg> Mọi giống chó & mèo</span></div>
            <div class="col"><span class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8a7 7 0 0 1-7 10z" /></svg> Sản phẩm thiên nhiên</span></div>
            <div class="col"><span class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg> Đặt lịch online dễ dàng</span></div>
        </div>
    </div>
</div>

<!-- ============================================================= SERVICES -->
@{
    var homeServices = ViewBag.Services as List<PET.Models.Service> ?? new List<PET.Models.Service>();
}
<section class="section bg-paper" id="services">
    <div class="container container-x">
        <div class="section-head center reveal mb-5">
            <span class="kicker"><svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg> Danh mục dịch vụ</span>
            <h2 class="section-title">Dịch vụ & bảng giá bé yêu thích</h2>
            <p class="section-sub">Giá tham khảo áp dụng cho thú cưng cỡ nhỏ. Xem chi tiết đầy đủ các gói dịch vụ trong hệ thống của chúng tôi.</p>
        </div>

        @if (homeServices.Any())
        {
            <div class="row g-4">
                @for (int i = 0; i < homeServices.Count; i++)
                {
                    var svc = homeServices[i];
                    string tintClass = (i % 3) switch
                    {
                        1 => "tint-coral",
                        2 => "tint-yellow",
                        _ => ""
                    };
                    string delayClass = (i % 3) switch
                    {
                        1 => "d1",
                        2 => "d2",
                        _ => ""
                    };

                    <div class="col-md-6 col-lg-4 reveal @delayClass">
                        <article class="svc-card @tintClass">
                            <div class="svc-ic">
                                @if (!string.IsNullOrEmpty(svc.ImageUrl))
                                {
                                    <img src="@svc.ImageUrl" alt="@svc.Name" class="rounded-circle" style="width: 44px; height: 44px; object-fit: cover;" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a2.12 2.12 0 0 0-3 3L6 9" /><path d="M2 15h20a2 2 0 0 1-2 2v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a2 2 0 0 1-2-2Z" /><path d="M9 12V6" /></svg>
                                }
                            </div>
                            <h3>
                                <a asp-controller="Services" asp-action="Details" asp-route-id="@svc.Id" class="text-decoration-none text-dark">
                                    @svc.Name
                                </a>
                            </h3>
                            <p class="svc-desc">@(string.IsNullOrEmpty(svc.Description) ? "Gói chăm sóc toàn diện, nhẹ nhàng chuẩn Fear-Free dành cho thú cưng." : svc.Description)</p>
                            <div class="svc-foot">
                                <div>
                                    <span class="svc-meta"><span class="from">từ</span> <span class="price">@svc.Price.ToString("N0")đ</span></span><br>
                                    <span class="svc-time"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg> @svc.DurationMinutes phút</span>
                                </div>
                                <a class="btn btn-ghost" asp-controller="Appointments" asp-action="Create" asp-route-serviceId="@svc.Id">Đặt lịch</a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">Chưa có dịch vụ nào được tạo trong hệ thống.</div>
        }

        <div class="text-center mt-5 reveal">
            <a class="btn btn-paw btn-lg btn-icon" asp-controller="Services" asp-action="Index">
                Xem tất cả dịch vụ
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
        </div>
    </div>
</section>

<!-- ============================================================= BEFORE / AFTER -->
<section class="section bg-wash" id="results">
    <div class="container container-x">
        <div class="row align-items-center g-5">
            <div class="col-lg-5 reveal">
                <span class="kicker is-coral">Lột xác ngoạn mục</span>
                <h2 class="section-title">Kéo thanh trượt để xem sự khác biệt</h2>
                <p class="section-sub mb-4">Mỗi buổi chăm sóc đều kết thúc với bộ lông bồng bềnh và thơm mát. Hãy kéo nút giữa để xem hình ảnh thực tế trước và sau khi làm đẹp.</p>
                <ul class="list-check">
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg> Gỡ rối mượt mà, phục hồi độ bóng khỏe của lông</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg> Cắt tỉa gọn gàng chuẩn form từng giống</li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg> Thơm tho, sạch sẽ, sẵn sàng ôm ấp</li>
                </ul>
            </div>
            <div class="col-lg-7 reveal d2">
                <div class="ba-slider" aria-label="Before and after grooming comparison">
                    <img src="~/img/ba-before-1.jpg" alt="Thú cưng trước khi cắt tỉa" width="1200" height="800" loading="lazy">
                    <span class="ba-tag before">Trước</span>
                    <div class="ba-after-wrap">
                        <img src="~/img/ba-after-1.jpg" alt="Thú cưng sau khi cắt tỉa gọn gàng" width="1200" height="800" loading="lazy">
                    </div>
                    <span class="ba-tag after">Sau</span>
                    <button type="button" class="ba-handle" role="slider" aria-label="Reveal amount" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-orientation="horizontal">
                        <span class="knob" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 7-5 5 5 5M15 7l5 5-5 5" /></svg></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

