<!-- ============================================================= RETAIL / ADD-ONS -->
@{
    var homeProducts = ViewBag.Products as List<PET.Models.Product> ?? new List<PET.Models.Product>();
}
<section class="section bg-cream">
    <div class="container container-x">
        <div class="d-md-flex align-items-end justify-content-between mb-5 reveal">
            <div class="section-head">
                <span class="kicker is-yellow">Cửa hàng phụ kiện & dinh dưỡng</span>
                <h2 class="section-title">Sản phẩm chăm sóc tại nhà</h2>
                <p class="section-sub mb-0">Các dòng sữa tắm, bánh thưởng và dụng cụ chải lông chuẩn Salon dành cho bé.</p>
            </div>
            <a class="btn btn-ghost mt-3 mt-md-0" asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>
        </div>

        @if (homeProducts.Any())
        {
            <div class="row g-4">
                @for (int i = 0; i < homeProducts.Count; i++)
                {
                    var prod = homeProducts[i];
                    string delayClass = i > 0 ? $"d{i}" : "";

                    <div class="col-6 col-lg-3 reveal @delayClass">
                        <div class="shop-card">
                            <div class="shop-thumb">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.Id">
                                    <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? Url.Content("~/img/product-1.jpg") : prod.ImageUrl)"
                                         alt="@prod.Name" width="300" height="300" loading="lazy">
                                </a>
                                @if (prod.StockQuantity <= 0)
                                {
                                    <span class="shop-flag bg-secondary text-white">Hết hàng</span>
                                }
                                else if (i == 0)
                                {
                                    <span class="shop-flag">Mới</span>
                                }
                            </div>
                            <div class="shop-body">
                                <span class="cat">@prod.Category</span>
                                <h3>
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.Id" class="text-decoration-none text-dark">
                                        @prod.Name
                                    </a>
                                </h3>
                                <div class="shop-foot">
                                    <span class="shop-price">@prod.Price.ToString("N0")đ</span>
                                    @if (prod.StockQuantity > 0)
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@prod.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="shop-add d-flex align-items-center justify-content-center border-0" title="Thêm vào giỏ hàng" aria-label="Thêm vào giỏ hàng">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">Chưa có sản phẩm nào được mở bán trên cửa hàng.</div>
        }
    </div>
</section>

