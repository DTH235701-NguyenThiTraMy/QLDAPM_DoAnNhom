@model List<PET.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal grandTotal = ViewBag.GrandTotal ?? 0m;
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <span class="kicker mb-2">
                    <svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
                    Cửa hàng Fetch
                </span>
                <h1 class="h2 fw-bold mb-0">Giỏ hàng của bạn</h1>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Products" asp-action="Index" class="btn btn-ghost">← Tiếp tục mua sắm</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-action="MyOrders" class="btn btn-outline-dark rounded-pill px-3 fw-bold">📦 Đơn hàng của tôi</a>
                }
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
                @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <div class="display-4 mb-3">🛒</div>
                <h3 class="h5 fw-bold mb-2">Giỏ hàng đang trống</h3>
                <p class="text-muted mb-4">Hãy ghé cửa hàng để chọn thức ăn, sữa tắm và đồ chơi cho boss nhà bạn nhé!</p>
                <div>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-paw px-4">Khám phá sản phẩm ngay</a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Danh sách sản phẩm trong giỏ -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 py-3">Sản phẩm</th>
                                        <th class="py-3">Đơn giá</th>
                                        <th class="py-3 text-center" style="width: 150px;">Số lượng</th>
                                        <th class="py-3 text-end">Thành tiền</th>
                                        <th class="pe-4 py-3 text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/img/product-1.jpg") : item.ImageUrl)"
                                                         alt="@item.ProductName"
                                                         class="rounded-3 border"
                                                         style="width: 64px; height: 64px; object-fit: cover;" />
                                                    <div>
                                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId"
                                                           class="fw-bold text-dark text-decoration-none">
                                                            @item.ProductName
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 fw-semibold">@item.Price.ToString("N0") đ</td>
                                            <td class="py-3">
                                                <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center align-items-center gap-1">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 30px; height: 30px; padding: 0;">-</button>
                                                    <span class="px-2 fw-bold">@item.Quantity</span>
                                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 30px; height: 30px; padding: 0;">+</button>
                                                </form>
                                            </td>
                                            <td class="py-3 text-end fw-bold text-primary">@item.Total.ToString("N0") đ</td>
                                            <td class="pe-4 py-3 text-end">
                                                <form asp-action="Remove" method="post">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle" title="Xóa khỏi giỏ">✕</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Tóm tắt thanh toán -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h4 class="h5 fw-bold mb-3 pb-3 border-bottom">Tóm tắt đơn hàng</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính (@Model.Sum(x => x.Quantity) sản phẩm):</span>
                            <span class="fw-bold">@grandTotal.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <span class="text-muted">Phí giao hàng:</span>
                            <span class="text-success fw-bold">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold fs-5">Tổng cộng:</span>
                            <span class="fw-bold fs-4 text-danger">@grandTotal.ToString("N0") đ</span>
                        </div>
                        <a asp-action="Checkout" class="btn btn-paw w-100 py-3 fw-bold justify-content-center">
                            Tiến hành đặt hàng →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>