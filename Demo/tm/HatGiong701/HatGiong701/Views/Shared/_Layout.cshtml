<!DOCTYPE html>
<html lang="vi">
@using System.Text.Json
@using HatGiong701.Models
@using HatGiong701.Data
@inject ApplicationDbContext _context

@{
        // 1. Lấy chuỗi JSON từ Session theo đúng key "shopcart" đã khai báo ở CartController
        var jsonCart = Context.Session.GetString("shopcart");
        var cartCount = 0;

        // 2. Nếu giỏ hàng có dữ liệu, chuyển chuỗi JSON về lại List<CartItem> và đếm số loại mặt hàng
        if (!string.IsNullOrEmpty(jsonCart))
        {
                var cartItems = JsonSerializer.Deserialize<List<CartItem>>(jsonCart);
                cartCount = cartItems?.Count ?? 0;
        }

        // 3. Lấy danh sách danh mục từ Database để hiển thị tự động trên Navbar và Footer
        var navCategories = _context.Categories.OrderBy(c => c.CategoryId).ToList();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cửa Hàng Hạt Giống Xanh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 text-nowrap" asp-area="" asp-controller="Home" asp-action="Index">
                    HạtGiống701
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-1 gap-xl-2 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-nowrap" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        <!-- MENU DROPDOWN DANH MỤC HẠT GIỐNG -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold text-nowrap" href="#" id="navbarDropdownCategories" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid me-1"></i> Danh mục
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownCategories">
                                <li>
                                    <a class="dropdown-item fw-semibold text-success" asp-area="" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-flower1 me-2"></i>Tất cả hạt giống
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @foreach (var cat in navCategories)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Home"
                                           asp-action="Index"
                                           asp-route-categoryId="@cat.CategoryId">
                                            <i class="bi bi-chevron-right small text-success me-1"></i>@cat.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold text-nowrap" asp-area="" asp-controller="Home" asp-action="Blog">
                                <i class="bi bi-journal-richtext me-1"></i> Cẩm nang
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-nowrap d-inline-flex align-items-center" asp-area="" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-cart3 me-1"></i> Giỏ hàng
                                    @if (cartCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark ms-1 fw-bold">@cartCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-nowrap" asp-area="" asp-controller="Home" asp-action="MyOrders">
                                    <i class="bi bi-bag-check me-1"></i> Đơn hàng
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link bg-warning text-dark rounded px-2 py-1 fw-bold text-nowrap small" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Quản trị
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="footer-custom text-white pt-5 pb-3 mt-auto">
        <div class="container">
            <div class="row g-4">

                <!-- Cột 1: Giới thiệu -->
                <div class="col-lg-4 col-md-6">
                    <h4 class="fw-bold mb-3 d-flex align-items-center">
                        <span class="me-2">🌱</span>HạtGiống701
                    </h4>
                    <p class="footer-description">
                        Đồng hành cùng bạn trong hành trình tạo nên
                        những khu vườn xanh. Cung cấp hạt giống chất lượng,
                        dễ trồng và có tỷ lệ nảy mầm cao.
                    </p>

                    <div class="d-flex gap-3 mt-3">
                        <!-- Facebook -->
                        <a href="https://www.facebook.com/profile.php?id=100063975436948"
                           class="footer-social"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <!-- TikTok -->
                        <a href="https://www.tiktok.com/@@hatgiongsenhong?is_from_webapp=1&sender_device=pc"
                           class="footer-social"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="TikTok">
                            <i class="bi bi-tiktok"></i>
                        </a>

                        <!-- YouTube -->
                        <a href="https://www.youtube.com/@@hatgiongsenhong"
                           class="footer-social"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>

                <!-- Cột 2: Liên kết -->
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-heading">LIÊN KẾT</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i>Trang chủ</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Blog"><i class="bi bi-chevron-right small me-1"></i>Cẩm nang</a></li>
                        <li><a asp-area="" asp-controller="Cart" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i>Giỏ hàng</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="MyOrders"><i class="bi bi-chevron-right small me-1"></i>Đơn hàng</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Danh mục hạt giống (Tự động lấy từ DB & lọc đúng theo CategoryId) -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">DANH MỤC HẠT GIỐNG</h6>
                    <ul class="list-unstyled footer-links">
                        @foreach (var cat in navCategories.Take(5))
                        {
                            <li>
                                <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoryId="@cat.CategoryId">
                                    <i class="bi bi-chevron-right small me-1"></i>@cat.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Cột 4: Liên hệ -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">THÔNG TIN LIÊN HỆ</h6>
                    <ul class="list-unstyled footer-contact">
                        <li class="d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill me-2 mt-1"></i>
                            <span>Cửa hàng Hạt Giống Xanh - An Giang</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <i class="bi bi-envelope-fill me-2 mt-1"></i>
                            <span class="text-break">my_dth235701@student.agu.edu.vn</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <i class="bi bi-telephone-fill me-2 mt-1"></i>
                            <span>0367 966 151</span>
                        </li>
                    </ul>
                </div>

            </div>

            <hr class="footer-divider my-4" />

            <!-- Bản quyền -->
            <div class="text-center">
                <p class="mb-1 fw-semibold">
                    © 2026 HATGIONG701 - CỬA HÀNG HẠT GIỐNG XANH
                </p>
                <small class="text-white-50">
                    Đồ án Công nghệ Web ASP.NET Core MVC by MY
                </small>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>