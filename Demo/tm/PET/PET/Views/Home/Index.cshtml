<!-- ============================================================= HAPPY CLIENTS GALLERY -->
<section class="section bg-paper">
    <div class="container container-x">
        <div class="section-head center reveal mb-5">
            <span class="kicker is-coral"><svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg> Khách hàng thân thiết</span>
            <h2 class="section-title">Khoảnh khắc đáng yêu tại Fetch</h2>
            <p class="section-sub">Những vị khách bốn chân rạng rỡ sau khi trải nghiệm dịch vụ. Bấm vào ảnh để phóng to.</p>
        </div>
        <div class="pet-grid reveal">
            <button class="g-item" data-lightbox="@Url.Content("~/img/pet-1.jpg")" data-caption="Bé Bailey sau khi tắm và chải lông" aria-label="Phóng to ảnh Bailey">
