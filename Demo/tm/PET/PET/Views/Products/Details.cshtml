@model PET.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <!-- Điều hướng quay lại -->
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none fw-bold text-muted">
                ← Quay lại cửa hàng sản phẩm
            </a>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="row g-0">
                        <!-- Cột trái: Hình ảnh sản phẩm -->
                        <div class="col-md-5 bg-light position-relative d-flex align-items-center justify-content-center" style="min-height: 340px;">
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/img/product-1.jpg") : Model.ImageUrl)"
                                 alt="@Model.Name"
                                 class="w-100 h-100"
                                 style="object-fit: cover;" />

                            @if (!Model.IsActive)
                            {
                                <span class="badge bg-secondary position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    Ngừng kinh doanh
                                </span>
                            }
                            else if (Model.StockQuantity > 0)
                            {
                                <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    ✔ Còn hàng (@Model.StockQuantity)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    Hết hàng
                                </span>
                            }
                        </div>

                        <!-- Cột phải: Nội dung chi tiết -->
                        <div class="col-md-7 p-4 p-md-5 d-flex flex-column justify-content-between">
                            <div>
                                <span class="kicker is-yellow mb-2">
                                    <svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
                                    @(string.IsNullOrEmpty(Model.Category) ? "Sản phẩm chăm sóc" : Model.Category)
                                </span>

                                <h1 class="h2 fw-bold mb-2">@Model.Name</h1>

                                <div class="d-flex align-items-baseline gap-2 mb-4">
                                    <span class="h3 fw-bold text-primary mb-0">@Model.Price.ToString("N0")đ</span>
                                    <span class="text-muted small">/ sản phẩm</span>
                                </div>

                                <div class="p-3 rounded-4 bg-light border mb-4">
                                    <div class="fw-bold text-dark small mb-1">Thông tin & Công dụng sản phẩm:</div>
                                    <p class="text-muted mb-0" style="line-height: 1.6;">
                                        @(string.IsNullOrEmpty(Model.Description) ? "Sản phẩm chăm sóc thú cưng chính hãng, an toàn và lành tính được khuyên dùng tại Fetch Salon." : Model.Description)
                                    </p>
                                </div>

                                <!-- Thông tin bổ sung cho Admin -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="row g-2 small text-muted bg-light p-3 rounded-3 border mb-4">
                                        <div class="col-6">
                                            <strong>Tồn kho:</strong> @Model.StockQuantity sản phẩm
                                        </div>
                                        <div class="col-6">
                                            <strong>Trạng thái:</strong> @(Model.IsActive ? "Đang mở bán" : "Đang ẩn")
                                        </div>
                                        <div class="col-12">
                                            <strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-2 small text-muted mb-4">
                                        <div class="col-6">✔ Cam kết chính hãng 100%</div>
                                        <div class="col-6">✔ An toàn cho da nhạy cảm</div>
                                        <div class="col-6">✔ Có sẵn tại quầy Fetch Salon</div>
                                        <div class="col-6">✔ Giảm 10% cho thành viên Spa</div>
                                    </div>
                                }
                            </div>

                            <!-- Thanh nút hành động -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                                <a asp-controller="Appointments" asp-action="Create" class="btn btn-paw btn-icon px-4">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                                    Đặt lịch kèm nhận tại Salon
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-ghost">Chỉnh sửa</a>
                                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-3">Xóa</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>