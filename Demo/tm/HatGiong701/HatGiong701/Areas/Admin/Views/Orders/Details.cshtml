@model HatGiong701.Models.Order
@{
    var formattedOrderCode = $"#ĐH{Model.OrderId:D4}";
    ViewData["Title"] = $"Chi tiết Đơn hàng {formattedOrderCode}";
}

<div class="container-fluid py-3">
    <!-- Header & Nút quay lại -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <!-- Breadcrumb điều hướng -->
            <nav aria-label="breadcrumb" class="mb-1">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" class="text-success text-decoration-none">Quản lý đơn hàng</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@formattedOrderCode</li>
                </ol>
            </nav>

            <!-- Tiêu đề & Huy hiệu trạng thái -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h3 class="fw-bold text-dark mb-0">Đơn hàng @formattedOrderCode</h3>
                @if (Model.Status == "Chờ xác nhận")
                {
                    <span class="badge rounded-pill bg-warning bg-opacity-25 text-dark px-3 py-2">
                        <i class="bi bi-clock me-1"></i>@Model.Status
                    </span>
                }
                else if (Model.Status == "Đang giao")
                {
                    <span class="badge rounded-pill bg-info bg-opacity-25 text-dark px-3 py-2">
                        <i class="bi bi-truck me-1"></i>@Model.Status
                    </span>
                }
                else if (Model.Status == "Hoàn thành")
                {
                    <span class="badge rounded-pill bg-success bg-opacity-25 text-success px-3 py-2">
                        <i class="bi bi-check-circle-fill me-1"></i>@Model.Status
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-danger bg-opacity-25 text-danger px-3 py-2">
                        <i class="bi bi-x-circle-fill me-1"></i>@Model.Status
                    </span>
                }
            </div>

            <p class="text-muted small mb-0 mt-1">
                <i class="bi bi-calendar3 me-1"></i>Đặt lúc: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        <!-- Nút quay lại căn phải -->
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary bg-white rounded-3 px-3 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Thông báo cập nhật thành công -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh tiến trình xử lý đơn hàng -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body py-3 px-4">
            @if (Model.Status == "Đã hủy")
            {
                <div class="d-flex align-items-center text-danger fw-semibold">
                    <i class="bi bi-x-octagon-fill fs-5 me-2"></i>
                    Đơn hàng này đã bị hủy và không được tính vào doanh thu.
                </div>
            }
            else
            {
                var step1Active = true;
                var step2Active = Model.Status == "Đang giao" || Model.Status == "Hoàn thành";
                var step3Active = Model.Status == "Hoàn thành";

                <div class="row text-center g-2 align-items-center">
                    <div class="col-4">
                        <div class="p-2 rounded-3 @(step1Active ? "bg-success bg-opacity-10 text-success fw-bold" : "text-muted")">
                            <i class="bi bi-1-circle-fill me-1"></i>Chờ xác nhận
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 @(step2Active ? "bg-success bg-opacity-10 text-success fw-bold" : "bg-light text-muted")">
                            <i class="bi bi-2-circle-fill me-1"></i>Đang giao hàng
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded-3 @(step3Active ? "bg-success bg-opacity-10 text-success fw-bold" : "bg-light text-muted")">
                            <i class="bi bi-3-circle-fill me-1"></i>Hoàn thành
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Khối thông tin giao hàng & Form cập nhật trạng thái -->
    <div class="row g-4 mb-4">
        <!-- Cột trái: Thông tin khách hàng -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-geo-alt-fill text-success me-2"></i>Thông tin người nhận & Giao hàng
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold"
                             style="width: 44px; height: 44px; font-size: 1.1rem;">
                            @(string.IsNullOrEmpty(Model.ReceiverName) ? "K" : Model.ReceiverName.Substring(0, 1).ToUpper())
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6">@Model.ReceiverName</div>
                            <div class="text-muted small">Khách hàng đặt mua</div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex align-items-start">
                        <i class="bi bi-telephone text-muted me-3 mt-1"></i>
                        <div>
                            <div class="small text-muted">Số điện thoại liên hệ</div>
                            <div class="fw-semibold text-dark">@Model.PhoneNumber</div>
                        </div>
                    </div>

                    <div class="mb-3 d-flex align-items-start">
                        <i class="bi bi-house-door text-muted me-3 mt-1"></i>
                        <div>
                            <div class="small text-muted">Địa chỉ nhận hàng</div>
                            <div class="fw-semibold text-dark">@Model.ShippingAddress</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <i class="bi bi-cash-coin text-muted me-3 mt-1"></i>
                        <div>
                            <div class="small text-muted">Phương thức thanh toán</div>
                            <span class="badge bg-light text-dark border mt-1">Thanh toán khi nhận hàng (COD)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Xử lý trạng thái đơn hàng -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sliders text-success me-2"></i>Xử lý & Cập nhật trạng thái
                    </h6>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />

                        <div class="mb-3">
                            <label for="statusSelect" class="form-label fw-semibold text-dark">
                                Chọn trạng thái xử lý mới
                            </label>
                            <select id="statusSelect" name="status" class="form-select form-select-lg rounded-3">
                                <option value="Chờ xác nhận" selected="@(Model.Status == "Chờ xác nhận")">Chờ xác nhận</option>
                                <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                                <option value="Hoàn thành" selected="@(Model.Status == "Hoàn thành")">Hoàn thành</option>
                                <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                            </select>
                            <div class="form-text text-muted mt-2">
                                <i class="bi bi-info-circle me-1"></i>Đơn hàng chuyển sang trạng thái <strong>Hoàn thành</strong> sẽ được tự động cộng vào doanh thu trên Dashboard.
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i>Lưu trạng thái
                            </button>
                            <a asp-action="Index" class="btn btn-light border rounded-3 px-4">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách hạt giống trong đơn -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-box-seam text-success me-2"></i>Danh sách sản phẩm trong đơn
            </h6>
            <span class="badge bg-light text-dark border">
                @(Model.OrderDetails?.Count ?? 0) loại hạt giống
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Sản phẩm hạt giống</th>
                        <th class="py-3 text-end">Đơn giá</th>
                        <th class="py-3 text-center">Số lượng</th>
                        <th class="py-3 text-end pe-4">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        foreach (var d in Model.OrderDetails)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(d.Seed?.ImageUrl))
                                        {
                                            <img src="@d.Seed.ImageUrl" alt="@d.Seed.Name"
                                                 class="rounded-3 border me-3 object-fit-cover"
                                                 style="width: 48px; height: 48px;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded-3 me-3 d-flex align-items-center justify-content-center text-muted"
                                                 style="width: 48px; height: 48px;">
                                                <i class="bi bi-flower1"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold text-dark">@(d.Seed?.Name ?? "Sản phẩm đã xóa")</div>
                                            @if (!string.IsNullOrEmpty(d.Seed?.PlantingSeason))
                                            {
                                                <small class="text-muted">Mùa vụ: @d.Seed.PlantingSeason</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end text-secondary">@d.UnitPrice.ToString("N0") ₫</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2">x @d.Quantity gói</span>
                                </td>
                                <td class="text-end pe-4 fw-bold text-dark">
                                    @((d.UnitPrice * d.Quantity).ToString("N0")) ₫
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Không có chi tiết sản phẩm.</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light">
                    <tr>
                        <td colspan="3" class="text-end py-3 fw-bold text-dark fs-6">Tổng giá trị thanh toán:</td>
                        <td class="text-end pe-4 py-3 text-danger fw-bold fs-5">@Model.TotalAmount.ToString("N0") ₫</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>