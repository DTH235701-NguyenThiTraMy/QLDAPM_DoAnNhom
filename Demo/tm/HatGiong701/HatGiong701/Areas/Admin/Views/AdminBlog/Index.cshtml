@model IEnumerable<HatGiong701.Models.BlogPost>

@{
    ViewData["Title"] = "QUẢN LÝ CẨM NANG GIEO TRỒNG";
    var totalPosts = Model.Count();
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                Quản lý cẩm nang gieo trồng
            </h3>
            <p class="text-muted small mb-0">Thêm mới, chỉnh sửa các bài viết hướng dẫn kỹ thuật và chăm sóc cây trồng</p>
        </div>
        <a asp-action="Create" class="btn btn-success rounded-3 px-3 shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i>Viết bài mới
        </a>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khung bảng chính -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <!-- Thanh tổng quan & Tìm kiếm -->
        <div class="card-header bg-white border-bottom py-3">
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-md-6">
                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                        Tổng cộng: @totalPosts bài viết
                    </span>
                </div>
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="blogSearchInput" class="form-control bg-light border-start-0"
                               placeholder="Tìm tiêu đề bài viết, chủ đề...">
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng dữ liệu -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="blogsTable">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3" style="width: 100px;">Ảnh bìa</th>
                        <th class="py-3">Bài viết</th>
                        <th class="py-3" style="width: 180px;">Chủ đề</th>
                        <th class="py-3 text-center" style="width: 130px;">Ngày đăng</th>
                        <th class="py-3 text-center pe-4" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 opacity-50"></i>
                                Chưa có bài viết nào. Hãy bấm <strong>Viết bài mới</strong> để tạo bài đầu tiên!
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="blog-row">
                                <td class="ps-4 py-3">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/seeds/seed1.jpg" : item.ImageUrl)"
                                         alt="@item.Title"
                                         class="rounded-3 border shadow-sm"
                                         style="width: 72px; height: 52px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark mb-1">@item.Title</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 420px;">
                                        @(string.IsNullOrEmpty(item.Summary) ? "Không có mô tả tóm tắt" : item.Summary)
                                    </small>
                                </td>
                                <td class="text-dark">
                                    @(string.IsNullOrEmpty(item.Category) ? "Chưa phân loại" : item.Category)
                                </td>
                                <td class="text-center text-muted small text-nowrap">
                                    @item.CreatedDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center pe-4 text-nowrap">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.BlogPostId" class="btn btn-sm btn-outline-primary rounded-3" title="Sửa bài viết">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.BlogPostId" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa bài viết">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("blogSearchInput")?.addEventListener("input", function () {
            const keyword = this.value.toLowerCase().trim();
            document.querySelectorAll(".blog-row").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(keyword) ? "" : "none";
            });
        });
    </script>
}