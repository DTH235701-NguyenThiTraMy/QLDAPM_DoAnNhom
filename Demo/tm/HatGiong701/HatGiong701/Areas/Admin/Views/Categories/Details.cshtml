@model HatGiong701.Models.Category

@{
    ViewData["Title"] = $"Chi tiết: {Model.Name}";
}

<div class="container-fluid py-3">
    <!-- Header & Breadcrumb -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb" class="mb-1">
                <ol class="breadcrumb small mb-0">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" class="text-success text-decoration-none">Quản lý danh mục</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết danh mục</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-1">
                Chi tiết danh mục hạt giống
            </h3>
            <p class="text-muted small mb-0">Thông tin phân loại sản phẩm trong hệ thống</p>
        </div>

        <a asp-action="Index" class="btn btn-light bg-white border text-dark rounded-3 px-3 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-info-circle-fill text-success me-2"></i>Thông tin chi tiết
                    </h6>
                </div>

                <div class="card-body p-4">
                    <div class="bg-light rounded-3 p-3 border">
                        <div class="row g-3">
                            <div class="col-sm-4 text-muted fw-semibold">
                                @Html.DisplayNameFor(model => model.Name):
                            </div>
                            <div class="col-sm-8 fw-bold text-dark fs-6">
                                @Html.DisplayFor(model => model.Name)
                            </div>

                            <div class="col-sm-4 text-muted fw-semibold">
                                @Html.DisplayNameFor(model => model.Description):
                            </div>
                            <div class="col-sm-8 text-secondary">
                                @(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả" : Model.Description)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer nút thao tác -->
                <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border rounded-3 px-4">Quay lại danh sách</a>
                    <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn btn-success rounded-3 px-4 fw-semibold">
                        <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa danh mục
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>