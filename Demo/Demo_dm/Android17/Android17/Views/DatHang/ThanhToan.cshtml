@model Android17.ViewModels.ThanhToanVM
@{
    Layout = "_LayoutMain";
    ViewData["Title"] = "Đặt hàng";
    var vn = new System.Globalization.CultureInfo("vi-VN");
    var gio = ViewBag.gio as List<Android17.Models.GioHang> ?? new List<Android17.Models.GioHang>();
    decimal tong = (decimal)ViewBag.tong;
    decimal phi = (decimal)ViewBag.phi;
    decimal thanhtien = (decimal)ViewBag.thanhtien;
    decimal mienphitu = (decimal)ViewBag.mienphitu;
}

<h4 class="text-warning border-bottom pb-1">Đặt hàng</h4>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <h5>Thông tin nhận hàng</h5>
        <form asp-action="ThanhToan" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NguoiNhan" class="form-label">Họ tên người nhận</label>
                <input asp-for="NguoiNhan" class="form-control" />
                <span asp-validation-for="NguoiNhan" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Sdt" class="form-label">Số điện thoại</label>
                <input asp-for="Sdt" class="form-control" />
                <span asp-validation-for="Sdt" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label">Địa chỉ nhận hàng</label>
                <input asp-for="DiaChi" class="form-control" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label">Ghi chú (không bắt buộc)</label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Phương thức thanh toán</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="PhuongThuc" value="COD" id="ptCod" />
                    <label class="form-check-label" for="ptCod">Thanh toán khi nhận hàng (COD)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="PhuongThuc" value="Chuyển khoản" id="ptCk" />
                    <label class="form-check-label" for="ptCk">Chuyển khoản ngân hàng</label>
                </div>
                <span asp-validation-for="PhuongThuc" class="text-danger"></span>
                <div class="form-text">Đây là website demo, không có giao dịch tiền thật.</div>
            </div>

            <button type="submit" class="btn btn-success">Xác nhận đặt hàng</button>
            <a asp-controller="GioHang" asp-action="Index" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Đơn hàng của bạn</h5>
                <ul class="list-unstyled mb-3">
                    @foreach (var g in gio)
                    {
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span>@g.Sp.TenSp <span class="text-muted">× @g.Sluong</span></span>
                            <span class="text-nowrap ms-2">@((g.Sluong * g.Sp.Gia).ToString("N0", vn)) ₫</span>
                        </li>
                    }
                </ul>
                <div class="d-flex justify-content-between">
                    <span>Tiền hàng</span>
                    <span>@tong.ToString("N0", vn) ₫</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Phí vận chuyển</span>
                    <span>@(phi == 0 ? "Miễn phí" : phi.ToString("N0", vn) + " ₫")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold">
                    <span>Tổng thanh toán</span>
                    <span class="text-danger">@thanhtien.ToString("N0", vn) ₫</span>
                </div>
                <div class="form-text mt-2">Miễn phí vận chuyển cho đơn từ @mienphitu.ToString("N0", vn) ₫.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}