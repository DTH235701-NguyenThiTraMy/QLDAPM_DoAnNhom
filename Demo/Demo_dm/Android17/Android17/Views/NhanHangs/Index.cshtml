@model IEnumerable<Android17.Models.NhanHang>
@{
    ViewData["Title"] = "Quản lý nhãn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Quản lý nhãn hàng</h4>
    <a asp-action="Create" class="btn btn-success">+ Thêm nhãn hàng</a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">@TempData["ThongBao"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tên nhãn hàng</th>
            <th class="text-center">Số sản phẩm</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenNhanHang</td>
                <td class="text-center">@item.SanPhams.Count</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@item.NhanHangId">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.NhanHangId" class="text-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>