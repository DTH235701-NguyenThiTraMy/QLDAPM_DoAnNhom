@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-1">
    @if (SignInManager.IsSignedIn(User))
    {
        var shortName = User.Identity?.Name?.Split('@')[0];
        <li class="nav-item">
            <a class="nav-link text-dark text-nowrap px-2 fw-bold" asp-area="Identity" asp-page="/Account/Manage/Index" title="@User.Identity?.Name">
                👤 @shortName
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-danger text-nowrap px-2 fw-bold border-0">Đăng xuất</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark text-nowrap px-2 fw-bold" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark text-nowrap px-2 fw-bold" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </li>
    }
</ul>