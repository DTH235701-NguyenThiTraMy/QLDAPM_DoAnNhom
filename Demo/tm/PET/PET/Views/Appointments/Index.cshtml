@model IEnumerable<PET.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý lịch hẹn Spa";
    int upcomingCount = ViewBag.UpcomingCount ?? 0;
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <!-- Tiêu đề & Nút đặt lịch mới -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3">
            <div class="section-head mb-0">
                <span class="kicker">
                    <svg class="paw" viewBox="0 0 24 24" fill="currentColor"><ellipse cx="12" cy="16" rx="5" ry="4.2" /><circle cx="5.5" cy="10" r="2.1" /><circle cx="10" cy="6.5" r="2.1" /><circle cx="14" cy="6.5" r="2.1" /><circle cx="18.5" cy="10" r="2.1" /></svg>
                    Lịch hẹn & Nhắc lịch
                </span>
                <h1 class="section-title mb-2">@(User.IsInRole("Admin") ? "Tất cả lịch hẹn của khách" : "Lịch hẹn Spa của bé")</h1>
                <p class="section-sub mb-0">Theo dõi thời gian chăm sóc, trạng thái xác nhận và nhắc nhở lịch hẹn sắp tới.</p>
            </div>

            <div>
                <a asp-action="Create" class="btn btn-paw btn-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    Đặt lịch hẹn mới
                </a>
            </div>
        </div>

        <!-- Thông báo thao tác -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">
                ✔ @TempData["SuccessMessage"]
            </div>
        }

        <!-- Banner Nhắc lịch thông minh trong 24h tới -->
        @if (upcomingCount > 0)
        {
            <div class="alert alert-warning rounded-4 border-0 shadow-sm d-flex align-items-center justify-content-between p-3 px-4 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size: 28px;">🔔</span>
                    <div>
                        <div class="fw-bold text-dark">Nhắc nhở lịch hẹn sắp tới!</div>
                        <div class="small text-muted">
                            @(User.IsInRole("Admin")
                                                    ? $"Có {upcomingCount} lịch hẹn của khách diễn ra trong vòng 24 giờ tới."
                                                    : $"Bạn có {upcomingCount} lịch hẹn Spa cho bé trong vòng 24 giờ tới. Đừng quên đưa bé đến đúng giờ nhé!")
                    </div>
                </div>
            </div>
        </div>
                }

        @if (!Model.Any())
        {
            <div class="text-center p-5 bg-white rounded-4 shadow-sm border">
                <div style="font-size: 48px;" class="mb-3">📅</div>
                <h3>Chưa có lịch hẹn nào</h3>
                <p class="text-muted mb-4">Hãy đặt ngay một buổi tắm gội, cắt tỉa thư giãn cho bé cưng của bạn nhé!</p>
                <a asp-action="Create" class="btn btn-paw">Đặt lịch ngay</a>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3">Thời gian hẹn</th>
                                <th class="py-3">Thú cưng</th>
                                <th class="py-3">Dịch vụ</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="py-3">Khách hàng</th>
                                }
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3">Nhắc lịch</th>
                                <th class="text-end pe-4 py-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                bool isSoon = item.AppointmentDate >= DateTime.Now &&
                                item.AppointmentDate <= DateTime.Now.AddHours(24) &&
                                (item.Status == "Pending" || item.Status == "Confirmed");

                                <tr class="@(isSoon ? "table-warning bg-opacity-25" : "")">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.AppointmentDate.ToString("dd/MM/yyyy")</div>
                                        <div class="small text-primary fw-bold">⏰ @item.AppointmentDate.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(string.IsNullOrEmpty(item.Pet?.ImageUrl) ? Url.Content("~/img/pet-1.jpg") : item.Pet.ImageUrl)"
                                                 alt="@item.Pet?.Name"
                                                 class="rounded-circle"
                                                 style="width: 38px; height: 38px; object-fit: cover;" />
                                            <div>
                                                <div class="fw-bold">@item.Pet?.Name</div>
                                                <div class="small text-muted">@item.Pet?.Species</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.Service?.Name</div>
                                        <div class="small text-muted">@item.Service?.Price.ToString("N0")đ (@item.Service?.DurationMinutes phút)</div>
                                    </td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td>
                                            <div class="small fw-bold">@item.User?.Email</div>
                                            @if (!string.IsNullOrEmpty(item.Notes))
                                            {
                                                <div class="small text-muted fst-italic">"@item.Notes"</div>
                                            }
                                        </td>
                                    }
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">⏳ Chờ xác nhận</span>
                                                break;
                                            case "Confirmed":
                                                <span class="badge bg-primary rounded-pill px-3 py-2">✔ Đã xác nhận</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-success rounded-pill px-3 py-2">🎉 Hoàn thành</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">✖ Đã hủy</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark rounded-pill px-3 py-2">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsReminded)
                                        {
                                            <span class="badge bg-info text-dark rounded-pill">🔔 Đã nhắc</span>
                                        }
                                        else if (isSoon)
                                        {
                                            <span class="badge bg-danger rounded-pill">Sắp đến giờ</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                @if (item.Status == "Pending")
                                                {
                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="Confirmed" />
                                                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">Duyệt</button>
                                                    </form>
                                                }
                                                @if (item.Status == "Confirmed")
                                                {
                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="Completed" />
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Hoàn thành</button>
                                                    </form>
                                                }
                                                @if (!item.IsReminded && (item.Status == "Pending" || item.Status == "Confirmed"))
                                                {
                                                    <form asp-action="SendReminder" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3" title="Gửi nhắc lịch">🔔 Nhắc</button>
                                                    </form>
                                                }
                                                @if (item.Status != "Cancelled" && item.Status != "Completed")
                                                {
                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2">Hủy</button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                @if (item.Status == "Pending")
                                                {
                                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Hủy lịch</button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>