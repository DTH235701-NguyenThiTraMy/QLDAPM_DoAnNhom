@{
    ViewData["Title"] = "Chính sách bảo mật";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white py-4 px-4">
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-shield-check me-2"></i>Chính sách bảo mật thông tin
                    </h3>
                    <p class="small mb-0 opacity-75">Cam kết bảo vệ quyền riêng tư và dữ liệu khách hàng tại HạtGiống701</p>
                </div>

                <div class="card-body p-4 p-md-5 text-secondary">
                    <h5 class="fw-bold text-dark mb-2">1. Mục đích thu thập thông tin</h5>
                    <p class="mb-4">
                        HạtGiống701 chỉ thu thập các thông tin cần thiết bao gồm: họ tên, email, số điện thoại và địa chỉ nhận hàng nhằm phục vụ việc xác nhận đơn hàng, giao nhận hạt giống tận nơi và hỗ trợ kỹ thuật gieo trồng cho khách hàng.
                    </p>

                    <h5 class="fw-bold text-dark mb-2">2. Phạm vi sử dụng & Bảo mật dữ liệu</h5>
                    <p class="mb-4">
                        Mật khẩu tài khoản được mã hóa an toàn trên hệ thống. Chúng tôi cam kết không chia sẻ, mua bán hoặc trao đổi thông tin cá nhân của khách hàng cho bất kỳ bên thứ ba nào ngoại trừ đơn vị vận chuyển phục vụ giao đơn hàng.
                    </p>

                    <h5 class="fw-bold text-dark mb-2">3. Quyền lợi của khách hàng</h5>
                    <p class="mb-0">
                        Khách hàng có quyền chủ động xem lại lịch sử đơn hàng, cập nhật thông tin hồ sơ cá nhân hoặc liên hệ trực tiếp với cửa hàng bất cứ lúc nào để được hỗ trợ giải đáp thắc mắc.
                    </p>
                </div>

                <div class="card-footer bg-light border-top py-3 px-4 text-end">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-success rounded-3 px-4 fw-semibold">
                        <i class="bi bi-house-door me-1"></i>Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>