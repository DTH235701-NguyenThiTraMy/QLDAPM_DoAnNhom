@model IEnumerable<PMPetCare.Models.Appointment>

@{
    ViewData["Title"] = "Tổng quan quản trị";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2>Dashboard quản trị</h2>
        <p class="text-muted">Tổng quan hoạt động hệ thống PMPetCare.</p>
    </div>

    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Tổng tài khoản</p>
                <h3>@ViewBag.UserCount</h3>
                <small>Khách hàng: @ViewBag.CustomerCount | Nhân viên: @ViewBag.StaffCount</small>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Thú cưng</p>
                <h3>@ViewBag.PetCount</h3>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Dịch vụ đang hoạt động</p>
                <h3>@ViewBag.ServiceCount</h3>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Tổng lịch hẹn</p>
                <h3>@ViewBag.AppointmentCount</h3>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Chờ xác nhận</p>
                <h3>@ViewBag.PendingCount</h3>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Đang thực hiện</p>
                <h3>@ViewBag.InProgressCount</h3>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3">
                <p class="text-muted mb-1">Đã hoàn thành</p>
                <h3>@ViewBag.CompletedCount</h3>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-white">
            <h5 class="mb-0">10 lịch hẹn mới nhất</h5>
        </div>

        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Khách hàng</th>
                                <th>Thú cưng</th>
                                <th>Dịch vụ</th>
                                <th>Nhân viên</th>
                                <th>Thời gian</th>
                                <th>Trạng thái</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var statusText = item.Status switch
                                {
                                    "Pending" => "Chờ xác nhận",
                                    "Assigned" => "Đã phân công",
                                    "InProgress" => "Đang thực hiện",
                                    "Completed" => "Đã hoàn thành",
                                    "Cancelled" => "Đã hủy",
                                    _ => item.Status
                                };

                                <tr>
                                    <td>@item.Customer?.FullName</td>
                                    <td>@item.Pet?.PetName</td>
                                    <td>@item.Service?.ServiceName</td>
                                    <td>@(item.Staff?.FullName ?? "Chưa phân công")</td>
                                    <td>@item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@statusText</td>
                                    <td>
                                        <a asp-controller="AdminAppointments"
                                           asp-action="Details"
                                           asp-route-id="@item.AppointmentId"
                                           class="btn btn-primary btn-sm">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Chưa có lịch hẹn nào.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="AdminAppointments" asp-action="Index"
           class="btn btn-primary">Quản lý lịch hẹn</a>

        <a asp-controller="AdminServices" asp-action="Index"
           class="btn btn-outline-primary">Quản lý dịch vụ</a>
    </div>
</div>
