@model Android17.Models.SanPham
@{
    var vn = new System.Globalization.CultureInfo("vi-VN");
    bool giam = Model.GiaGoc.HasValue && Model.GiaGoc > Model.Gia;
}
<div class="card h-100 shadow-sm">
    <a asp-controller="Main" asp-action="Details" asp-route-id="@Model.Spid" class="text-decoration-none">
        <div class="ratio ratio-1x1 bg-light">
            <img src="~/images/@Model.Anh" alt="@Model.TenSp" class="object-fit-contain p-2"
                 onerror="this.style.display='none'" />
        </div>
    </a>
    <div class="card-body d-flex flex-column">
        <small class="text-muted">@Model.NhanHang.TenNhanHang</small>
        <a asp-controller="Main" asp-action="Details" asp-route-id="@Model.Spid"
           class="text-decoration-none text-dark fw-semibold">@Model.TenSp</a>
        <div class="mt-auto pt-2">
            <span class="text-danger fw-bold">@Model.Gia.ToString("N0", vn) ₫</span>
            @if (giam)
            {
                <br />
                <small class="text-decoration-line-through text-muted">@Model.GiaGoc!.Value.ToString("N0", vn) ₫</small>
            }
        </div>
    </div>
</div>