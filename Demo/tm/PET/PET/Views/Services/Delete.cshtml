@model PET.Models.Service

@{
    ViewData["Title"] = "Xóa dịch vụ " + Model.Name;
}

<section class="section bg-paper" style="padding-top: 120px; padding-bottom: 80px; min-height: 85vh;">
    <div class="container container-x">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <!-- Nút quay lại -->
                <div class="mb-3">
                    <a asp-action="Index" class="text-decoration-none fw-bold text-muted">
                        ← Quay lại danh sách dịch vụ
                    </a>
                </div>

                <!-- Card Xác nhận xóa -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-danger text-white p-4">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span style="font-size: 22px;">⚠️</span>
                            <h1 class="h4 fw-bold mb-0">Xác nhận xóa dịch vụ</h1>
                        </div>
                        <p class="small mb-0 opacity-90">Hành động này không thể hoàn tác. Dịch vụ này sẽ bị gỡ bỏ khỏi danh sách đặt lịch của hệ thống.</p>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        <!-- Thẻ tóm tắt thông tin dịch vụ sắp xóa -->
                        <div class="d-flex flex-column flex-sm-row align-items-center gap-4 p-3 rounded-4 bg-light border mb-4">
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content("~/img/hero-grooming.jpg") : Model.ImageUrl)"
                                 alt="@Model.Name"
                                 class="rounded-4 shadow-sm"
                                 style="width: 110px; height: 110px; object-fit: cover;" />

                            <div class="text-center text-sm-start flex-grow-1">
                                <div class="d-flex flex-wrap justify-content-center justify-content-sm-start align-items-center gap-2 mb-1">
                                    <h3 class="h4 fw-bold mb-0">@Model.Name</h3>
                                    <span class="badge bg-primary rounded-pill">@Model.Price.ToString("N0")đ</span>
                                    <span class="badge bg-warning text-dark rounded-pill">⏱ @Model.DurationMinutes phút</span>
                                </div>
                                <p class="text-muted small mb-0">
                                    <strong>Mô tả:</strong> @(string.IsNullOrEmpty(Model.Description) ? "Gói chăm sóc tiêu chuẩn." : Model.Description)
                                </p>
                            </div>
                        </div>

                        <!-- Form xác nhận -->
                        <form asp-action="Delete" class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <input type="hidden" asp-for="Id" />
                            <a asp-action="Index" class="btn btn-ghost">Hủy, giữ lại dịch vụ</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                🗑️ Xác nhận xóa vĩnh viễn
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>